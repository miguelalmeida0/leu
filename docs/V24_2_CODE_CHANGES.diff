@@ -0,0 +1,77 @@
+import SwiftUI
+import ShelfCore
+
+@MainActor
+struct UnderstandingLensSheet: View {
+    let reader: ReaderModel
+    @Bindable var model: LearningModel
+    let source: LearningSource
+    @Environment(\.dismiss) private var dismiss
+
+    var body: some View {
+        ShelfSheet(title: "Understanding Lens") {
+            ScrollView {
+                VStack(alignment: .leading, spacing: 18) {
+                    Text(source.sourceText)
+                        .accessibilityIdentifier("lens-origin-passage")
+                        .font(.system(.body, design: .serif))
+                        .foregroundStyle(ShelfTheme.secondary)
+                        .padding(.leading, 12)
+                        .overlay(alignment: .leading) { Rectangle().fill(ShelfTheme.accent).frame(width: 2) }
+                    if facts.isEmpty {
+                        Text("Leu does not have a verified relationship for this passage yet.")
+                            .font(ShelfTheme.editorial(26))
+                            .accessibilityIdentifier("understanding-lens-empty")
+                        Text("Nothing is generated to fill the gap.")
+                            .font(.callout).foregroundStyle(ShelfTheme.secondary)
+                    } else {
+                        ForEach(facts, id: \.proposition.id) { item in
+                            Button {
+                                if reader.knowledge.queueLensNavigation(to: item.proposition.evidence.learningSource, from: source) {
+                                    dismiss()
+                                }
+                            } label: {
+                                VStack(alignment: .leading, spacing: 5) {
+                                    Text(item.concept.canonicalName)
+                                        .font(.headline).foregroundStyle(ShelfTheme.text)
+                                    Text(item.proposition.relation.questionVerb + " " + item.proposition.objectText)
+                                        .font(.system(.body, design: .serif)).foregroundStyle(ShelfTheme.text)
+                                    Text("p. \(item.proposition.evidence.pageIndex + 1) · \(item.proposition.truthClass.rawValue)")
+                                        .font(.caption).foregroundStyle(ShelfTheme.secondary)
+                                }
+                                .frame(maxWidth: .infinity, alignment: .leading)
+                                .padding(.vertical, 9)
+                            }
+                            .buttonStyle(.plain)
+                            .accessibilityIdentifier("understanding-lens-fact-" + item.proposition.id)
+                            .accessibilityLabel(item.concept.canonicalName + ": " + item.proposition.relation.questionVerb + " " + item.proposition.objectText)
+                            .accessibilityValue("Page \(item.proposition.evidence.pageIndex + 1)")
+                        }
+                    }
+                }
+                .padding(ShelfTheme.gutter)
+            }
+            .background { UITestFrameProbe(identifier: "lens-scroll-frame") }
+        }
+        .background { UITestFrameProbe(identifier: "understanding-lens") }
+    }
+
+    private var facts: [(concept: SemanticConcept, proposition: SemanticProposition)] {
+        let selectedText = source.sourceText.lowercased()
+        let all = model.snapshot.semanticIndexes.values.flatMap { index in
+            index.propositions.compactMap { proposition -> (SemanticConcept, SemanticProposition)? in
+                guard proposition.isQuizTruth,
+                      let concept = index.concepts.first(where: { $0.id == proposition.subjectID }) else { return nil }
+                let sameConcept = selectedText.contains(concept.canonicalName.lowercased())
+                guard sameConcept else { return nil }
+                return (concept, proposition)
+            }
+        }
+        return Array(all.sorted {
+            let left = $0.1.evidence, right = $1.1.evidence
+            if left.documentID != right.documentID { return left.documentID.uuidString < right.documentID.uuidString }
+            if left.pageIndex != right.pageIndex { return left.pageIndex < right.pageIndex }
+            return $0.1.id < $1.1.id
+        }.prefix(24))
+    }
+}
