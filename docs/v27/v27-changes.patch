+                        .foregroundStyle(moved && state.keys == .stableIDs ? Color.green : ShelfTheme.secondary)
+                        .accessibilityLabel(moved && state.keys == .stableIDs ? "Identity preserved" : "Item")
+                    Text(item).font(.system(.title, design: .serif))
+                    Spacer()
