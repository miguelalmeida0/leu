+#!/usr/bin/env python3
+"""Reject a purported green run if native test coverage was missing, skipped or failed."""
+from pathlib import Path
+import re
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def expected_tests(folder: Path) -> set[tuple[str, str]]:
+    expected: set[tuple[str, str]] = set()
+    for source in folder.glob('*.swift'):
+        text = source.read_text()
+        classes = re.findall(r'\b(?:final\s+)?class\s+(\w+)\s*:\s*\w+', text)
+        methods = re.findall(r'\bfunc\s+(test\w+)\s*\(', text)
+        if methods:
+            if len(classes) != 1:
+                raise ValueError(f'Cannot unambiguously inventory test class: {source.name}')
+            expected.update((classes[0], method) for method in methods)
+    return expected
+
+
+def verify(text: str, expected: set[tuple[str, str]], marker: str) -> list[str]:
+    if marker not in text:
+        return [f'Missing completed stage: {marker}']
+    stage = text.split(marker, 1)[1].split('\n=== ', 1)[0]
+    outcomes = re.findall(r"Test Case '-\[(?:\w+\.)?(\w+)\s+(test\w+)\]' (passed|failed|skipped)", stage)
+    passed = {(suite, method) for suite, method, result in outcomes if result == 'passed'}
+    issues = [f'{suite}.{method}: {result}' for suite, method, result in outcomes if result != 'passed']
+    issues += [f'Not recorded as passed: {suite}.{method}' for suite, method in sorted(expected - passed)]
+    if '** TEST SUCCEEDED **' not in stage:
+        issues.append('Native stage did not report TEST SUCCEEDED.')
+    return issues
+
+
+def main() -> int:
+    if len(sys.argv) != 2:
+        print('Usage: verify-qa-results.py <complete-native-qa-log>', file=sys.stderr)
+        return 2
+    text = Path(sys.argv[1]).read_text(errors='replace')
+    issues = verify(text, expected_tests(ROOT / 'ShelfTests'),
+                    '=== Leu Apple PDF integration and viewport geometry tests ===')
+    issues += verify(text, expected_tests(ROOT / 'ShelfUITests'),
+                     '=== Leu screen-by-screen XCUITest audit ===')
+    progress = {( 'ShelfLearningOSUITests', method) for method in [
+        'test36LearningTimelineAndConnectionsOpen', 'test39LearningObjectSurvivesRelaunch',
+        'test40LearningStateIsARealRecallEntryPoint']}
+    progress |= expected_tests(ROOT / 'ShelfUITests') & {
+        ('ShelfStudyInteractionUITests', 'test48ProgressReopensAfterScrollingAndBothTabsWork'),
+        ('ShelfStudyInteractionUITests', 'test49StudySecondaryButtonsOpenRealDestinationsAndCollapse')}
+    issues += verify(text, progress, '=== Leu Study interaction gate (36 / 39 / 40 / 48 / 49) ===')
+    if issues:
+        print('FAIL: complete native coverage was not established.')
+        print('\n'.join(' - ' + issue for issue in issues))
+        return 1
+    print('PASS: 20 Apple tests, 5 Study gate tests, and all 50 UI tests explicitly passed; no skips or failure-retries accepted.')
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
